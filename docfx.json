{
  "metadata": [
    {
      "src": [
        {
          "src": "lab1",
          "files": ["**/*.csproj"],
          "exclude": ["**/bin/**", "**/obj/**", "**/*_Tests/**", "**/*Tests*.csproj"]
        }
      ],
      "dest": "api",
      "includePrivateMembers": true,
      "disableDefaultFilter": true
    }
  ],
  "build": {
    "content": [
      { "files": ["api/**.yml", "api/index.md"] },
      { "files": ["index.md", "toc.yml"] }
    ],
    "dest": "_site"
  }
}

